# RateWise AI backend environment
# Copy to .env, replace values, then restart npm run dev.

PORT=8080
NODE_ENV=development

# Local development can use *.
# Production must use your real frontend origin, for example:
# APP_ORIGIN=https://ratewise.example.com
APP_ORIGIN=*

# Required for Gemini AI analysis.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.5-flash-lite

